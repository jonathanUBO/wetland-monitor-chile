# Backend Environment Variables
# Copernicus Data Space Ecosystem (CDSE) Credentials (https://dataspace.copernicus.eu)
# Copy this file to .env and fill in your values.

# Option 1: Standard Copernicus Account (Email + Password)
CDSE_USERNAME=usuario@ejemplo.com
CDSE_PASSWORD=tu_contraseña_aqui

# Option 2: OAuth2 Client Credentials (if using CDSE registered OAuth client)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# API & Server Settings
BACKEND_URL=http://localhost:8000
PORT=8000
HOST=0.0.0.0
DEBUG=True
